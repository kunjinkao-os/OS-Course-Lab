{
	"name": "ChCore-Dev",
	"build": {
		"dockerfile": "../scripts/docker/arm64/Dockerfile",
		"context": "..",
		"options": ["--platform=linux/arm64"]
	},
	"remoteUser": "stu",
	"updateRemoteUserUID": true,
	"runArgs": ["--hostname", "Chcore", "--platform", "linux/arm64"],
	"customizations": {
		"vscode": {
		"extensions": [
			"ms-vscode.cpptools",
			"llvm-vs-code-extensions.vscode-clangd",
			"ms-vscode.makefile-tools"
		]
	}
  }
}
