FROM oscourselab-devcontainer:latest
USER root
RUN sed -i 's|http://apt.llvm.org|https://apt.llvm.org|g' /etc/apt/sources.list \
    && apt-get -o Acquire::Retries=1 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update \
    && apt-get install -y --no-install-recommends gdb-multiarch clangd-16 python3-pyelftools \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/clangd-16 /usr/local/bin/clangd \
    && ln -sf /usr/bin/clang-tidy-16 /usr/local/bin/clang-tidy \
    && groupmod -g 1012 stu \
    && usermod -u 1012 -g 1012 stu \
    && chown -R stu:stu /home/stu
USER stu
